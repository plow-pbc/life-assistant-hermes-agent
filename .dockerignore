# Build context is the repo root; only the agent's own content belongs in it.
.git
.env
.env.example
# `**/` is load-bearing: a bare `__pycache__` matches only the context root,
# and the ones that matter are under every skill's scripts/ directory. A stray
# a .pyc can also carry a stale path compiled before an edit.
**/__pycache__
**/*.py[co]
**/.pytest_cache

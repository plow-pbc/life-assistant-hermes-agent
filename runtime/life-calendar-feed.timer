# Five minutes: the strip shows a seven-day window, so a tick that is missed or
# late costs nothing, and the script's own hour-long backoff after three
# failures is what keeps a dead Pi from being retried at this cadence forever.
[Unit]
Description=Publish the Life calendar feed every five minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
Persistent=true
Unit=life-calendar-feed.service

[Install]
WantedBy=timers.target

#!/command/with-contenv sh
# shellcheck shell=sh
# Usage reporter: pushes this agent's token usage to the agent index.
#
# Same conditional-slot idiom as the dashboard service: if the reporter is
# not switched on, exit 0 and let the finish script return 125 so s6 marks
# the slot down rather than restarting it forever.

# Read from the agent's OWN dotenv, never the environment: a compose override
# is shared by every instance on the checkout and would opt in siblings.
# Through ld-shared's runtime_env, the repo's one parser, so two readers cannot
# disagree about a line -- and it parses rather than sources, because that file
# holds credentials. Empty lookup means the slot stays down. README, "Usage
# reporting", has the rest.
AGENT_INDEX=$(/opt/hermes/.venv/bin/python3 \
  /opt/data/skills/ld-shared/scripts/runtime_env.py AGENT_INDEX 2>/dev/null)

[ "${AGENT_INDEX:-}" = 1 ] || exit 0

# The client is fetched, not committed, and bind-mounted from the checkout. A
# bind with no source does not fail -- the runtime creates a DIRECTORY at the
# target -- so check for a regular file and name the fix, because nothing else
# would say why an otherwise healthy agent reports nothing.
if [ ! -f /usr/local/bin/agent-index-client ]; then
    echo "agent-index: /usr/local/bin/agent-index-client is not a file --" \
         "run \`just client\` in the agent repo and restart; the mount has" \
         "no source, so the runtime created a directory in its place"
    exit 0
fi

# HOME is set explicitly, NOT inherited. s6-setuidgid changes uid/gid but
# leaves HOME pointing at root's, and the client resolves its token path with
# expanduser(), which reads $HOME before falling back to /etc/passwd. Without
# this the login dies on PermissionError writing /root/.agent-index, and the
# token never reaches the bind-mounted home it is supposed to persist in.
# That failure is silent in the reporting path: an agent with no usage prints
# "nothing to report" and exits 0 before it ever needs the token.
#
# HERMES_HOME is named for the same class of reason. The base image happens to
# export HERMES_HOME=/opt/data today, so the client already finds the store at
# /opt/data/state.db -- this changes nothing right now. It is here because the
# client's OWN fallback is $HOME/.hermes/state.db, which is wrong for this
# image, so the correct path currently depends on an env var owned by a base
# image we pin by digest and periodically bump. A store that is not found is
# not an error: the reporter posts a cheerful zero and the agent lands on the
# index looking like one nobody uses.
#
# The non-zero exit is deliberately not fatal to the loop. The client exits
# non-zero when every collector fails and it refuses to publish a zero it never
# measured, which is right there and the wrong trigger for a restart here: a
# collector failing is a data problem, not a liveness one, and letting it kill
# the run script would flap the slot because agentsview was briefly busy. The
# echo replaces a bare `|| true`, which would have swallowed that signal and
# left no trace in this service's own output.
#
# One-shot client on a timer: it has no scheduler of its own by design, and a
# second scheduler inside a supervised container is a 2am bug. s6 owns the
# lifecycle, this loop owns only the interval. The client reads AGENT_ID from
# the environment itself, so it is neither rechecked nor forwarded here.
exec s6-setuidgid hermes env HOME=/opt/data HERMES_HOME=/opt/data sh -c '
  while :; do
    /opt/hermes/.venv/bin/python3 /usr/local/bin/agent-index-client \
      || echo "agent-index: reporter exited non-zero, see the COLLECTOR FAILED line above"
    sleep 3600
  done
'

#!/command/with-contenv sh
# shellcheck shell=sh
# Usage reporter: pushes this agent's token usage to the agent index.
#
# Same conditional-slot idiom as the dashboard service: if the reporter is
# not switched on, exit 0 and let the finish script return 125 so s6 marks
# the slot down rather than restarting it forever.

case "${AGENT_INDEX:-}" in
    1|true|TRUE|True|yes|YES|Yes) ;;
    *) exit 0 ;;
esac

# HOME is set explicitly, NOT inherited. s6-setuidgid changes uid/gid but
# leaves HOME pointing at root's, and the client resolves its token path with
# expanduser(), which reads $HOME before falling back to /etc/passwd. Without
# this the login dies on PermissionError writing /root/.agent-index, and the
# token never reaches the bind-mounted home it is supposed to persist in.
# That failure is silent in the reporting path: an agent with no usage prints
# "nothing to report" and exits 0 before it ever needs the token.
#
# HERMES_HOME is named rather than left to resolve, and it is NOT the same
# path as HOME would imply. The base image happens to export
# HERMES_HOME=/opt/data today, so the client already finds the store at
# /opt/data/state.db -- this line changes nothing right now. It is here
# because the client's OWN fallback is $HOME/.hermes/state.db, which is wrong
# for this image, so the correct path currently depends on an env var owned by
# a base image we pin by digest and periodically bump.
#
# The reason that dependency is worth removing: a store that is not found is
# not an error. from_hermes returns {} and the reporter posts a cheerful zero,
# so the agent lands on the index looking like one nobody uses. There is no
# crash and no red check -- just a wrong number, indefinitely.
#
# One-shot client on a timer: it has no scheduler of its own by design, and a
# second scheduler inside a supervised container is a 2am bug. s6 owns the
# lifecycle, this loop owns only the interval.
#
# The client reads AGENT_ID from the environment itself, so it is neither
# rechecked nor forwarded here: two validation paths for one variable is one
# more than the failure deserves. agent-mgr requires AGENT_ID, and an agent
# that cannot say who it is should not report anonymously.
#
# The interval is fixed. It was configurable while the cadence was being
# validated; nothing in production sets it, and the file is a mount now, so
# a shorter cadence for testing is an edit rather than a rebuild.
exec s6-setuidgid hermes env HOME=/opt/data HERMES_HOME=/opt/data sh -c '
  while :; do
    /opt/hermes/.venv/bin/python3 /usr/local/bin/agent-index-client || true
    sleep 3600
  done
'

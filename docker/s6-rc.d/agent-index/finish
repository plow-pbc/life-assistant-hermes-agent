#!/command/with-contenv sh
# shellcheck shell=sh
# $1 is run's exit status, which is the only thing this needs to know.
#
# run exits 0 without exec'ing when the reporter is switched off, so a zero
# here means "deliberately not running" and 125 -- s6-supervise's "permanent
# failure, do not restart" marker -- puts the slot down instead of spinning.
#
# Anything else means the supervised loop died, and that should come back.
# The dashboard service returns 125 unconditionally, which is right for a UI
# whose absence you can see and wrong for a background job whose absence is
# silent.
#
# Reading the exit status rather than re-deriving the switch is not only
# shorter: the switch now lives in the agent's own dotenv, which this script
# has no reason to parse and would get wrong if it tried, because it is not in
# the environment at all.
[ "${1:-0}" -eq 0 ] && exit 125
exit 0

# Written in place by `agent-mgr activate <agent>`. Do not fill these by hand: the chat uid
# and token are minted together by the activation exchange, and a hand-typed
# pair that does not match will authenticate as nothing.
#
# The token that lands here is THIS INSTANCE'S OWNER's Plow credential.
# POST /v1/auth/activate takes no credential at all — the binding is whichever
# phone texts the code back — so this is that owner's account, and the
# plow-connectors skill reusing this same token is what makes it their mail,
# their calendar and their Slack rather than anyone else's.
#
# Activation also writes PLOW_CHAT_BASE_URL and PLOW_CHAT_HOME_CHANNEL. They are
# absent here because nothing chooses them: the script derives both.
PLOW_CHAT_CHAT_UID=
PLOW_CHAT_TOKEN=

# The Plow relay credential for this agent, and which Mac it reaches. Mint both
# from that owner's Mac running Plow Latch:
#   POST /v1/relay/agents  (needs the relay:device scope, which only that Mac holds)
# The response carries the token and a ready-made mcp_config. Never commit real
# values.
DOMO_MCP_TOKEN=
DOMO_DEVICE_UID=

# Where the life-dashboard producers POST their cards, and the bearer the kiosk
# checks. Read from this dotenv by ld-shared/scripts/post_to_kiosk.py at run
# time -- the Hermes half of its file-or-env pair.
#
# The endpoint is the Pi's TAILNET address, never localhost: the producers run
# in a container on the agent host, so localhost is that container's own
# loopback. The token is minted on the Pi and copied here file-to-file.
DASHBOARD_ENDPOINT_URL=
DASHBOARD_TOKEN=

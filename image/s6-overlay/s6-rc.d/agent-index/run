#!/command/with-contenv sh
# Report this agent's token usage to the Agent Index, every 5 minutes.
#
# NO SWITCH. The reporter is here because somebody put it in this image, and
# that is the decision: an agent whose owner does not want their usage on the
# index is one built without this service. A flag would re-ask a question the
# Dockerfile has already answered, in a second place that can disagree with it.
#
# Baked in rather than bind-mounted: a mount whose source is missing does not
# fail, it creates a DIRECTORY at the target, and the reporter starts against a
# directory and reports nothing. Built in, the file is in the image or the
# build failed.

# Absolute, for the same reason the calendar feed's is: a service inherits the
# supervision tree's PATH, not a login shell's.
PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH

# PLOW_API_BASE, AGENT_ID and PLOW_AGENT_TOKEN come from the shebang's
# with-contenv, which hands this script the container environment first boot
# published. AGENT_ID is which agent this is; without it there is nothing to
# report FOR, so the service stands down rather than guessing a name.
#
# PLOW_API_BASE is also where the registration exchange goes. The client
# defaults to https://api.plow.co, which is past the proxy that holds this
# agent's real bearer -- so behind one, the exchange has to be sent where the
# token is.
export AGENT_ID

# The agent's home is where its usage store lives, and the client keeps its
# ledger beside that store. Fixed, not overridable: this image puts the home
# there, and a second way to say where it is only creates the case where the
# reporter and the agent disagree about which store is theirs.
HERMES_HOME=/var/lib/hermes
export HERMES_HOME

# Every invocation of the client, with an environment this script states in
# full. `env -i` and not an unset per name: with-contenv hands this script the
# whole container environment -- the Plow bearer, its inference alias, the
# loopback API key, whatever a later boot publishes -- and a child inherits all
# of it unless told otherwise. Naming what to drop means a name added later
# leaks by default; naming what to keep means it cannot. The bearer is not in
# here: only the registration exchange below adds it.
#
# TZ only when the container has one: this image's cont-init writes it from the
# household's config, and an EMPTY TZ is worse than none.
client() {
  /command/s6-setuidgid hermes env -i \
    PATH="$PATH" HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" \
    AGENT_ID="$AGENT_ID" PLOW_API_BASE="$PLOW_API_BASE" ${TZ:+TZ="$TZ"} \
    "$@"
}

if [ -z "$AGENT_ID" ]; then
  echo "agent-index: no AGENT_ID in this container's environment, so there is no" >&2
  echo "agent to report for -- standing down. Set it where this container is" >&2
  echo "started (plow-agents compose.yml)." >&2
  exec sleep 86400
fi

while :; do
  # The pinned client owns assertion exchange, aik_ format and atomic storage.
  # The image only invokes it; no image-owned HTTP path can hand the broad Plow
  # bearer to the Index.
  # Registered already? The client owns that question. Where this install's
  # state lives is its business, and it MOVES it -- this gate used to test
  # $HERMES_HOME/.agent-index/token, a path the client only ever DELETES once
  # its own state file holds the key. The test was true forever, so every tenant
  # re-registered on the hour and minted a fresh key each time.
  #
  #   0  registered      3  not registered      2  state is there, unreadable
  #
  # 2 is not 3, and this must not collapse them: registering over state the
  # client could not read mints against a new install id and strands the usage
  # this install has already published. That pass is skipped instead. The
  # contract and why it has three answers are in the client's README.
  #
  # stdout is dropped -- it says the same thing every pass. stderr is not: on 2
  # it carries the client's account of WHICH file it could not read.
  client /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py status >/dev/null
  case $? in
    0) ;;
    3)
      # The one invocation with a use for the bearer: it exchanges it for the
      # report-only key everything else authenticates with.
      client env PLOW_AGENT_TOKEN="$PLOW_AGENT_TOKEN" \
        /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
        --register --agent "$AGENT_ID" >/dev/null || {
      echo "agent-index: no index key this pass, not reporting" >&2
      /bin/sleep 300
      continue
      }
      ;;
    *)
      echo "agent-index: the client could not read this install's state (above);" >&2
      echo "standing off rather than registering over it." >&2
      /bin/sleep 300
      continue
      ;;
  esac

  # No bearer here, and nothing else the container environment holds: the
  # client finds the key the exchange stored in the agent's home and reports
  # with that.
  #
  # Never fatal. A collector that failed says so and exits non-zero; a crashing
  # longrun would be respawned in a tight loop, which turns one bad pass into a
  # hot loop against the index.
  client /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
    || echo "agent-index: reporter exited non-zero, see the line above" >&2
  /bin/sleep 300
done

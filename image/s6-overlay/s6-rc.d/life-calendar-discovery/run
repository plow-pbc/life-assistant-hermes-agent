#!/bin/sh
# Discovery owns its persisted retry schedule; this loop only checks when due.
set -eu

PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH

# latch's settings, as the gateway's run sets them, and the root-owned values
# latch logs in and acts with, read before dropping to the agent UID: the
# agent's own Plow credential (or the proxy that adds it) and the home chat
# every call acts for. Never source the agent-writable dotenv here.
export HOME=/var/lib/hermes LATCH_STATE_DIR=/var/lib/hermes/latch LATCH_NO_UPDATE_CHECK=1
for name in PLOW_AGENT_TOKEN PLOW_API_BASE PLOW_API_URL PLOW_HOME_CHANNEL; do
  if [ -s "/run/s6/container_environment/$name" ]; then
    export "$name=$(cat "/run/s6/container_environment/$name")"
  fi
done

while :; do
  /command/s6-setuidgid hermes \
    /opt/hermes/.venv/bin/python3 \
    /opt/plow/ld-setup/scripts/calendar_discovery.py --refresh \
    || echo "calendar discovery: refresh exited non-zero; retrying at the next tick" >&2
  /bin/sleep 300
done

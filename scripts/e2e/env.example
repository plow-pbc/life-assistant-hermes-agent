# Copied to scripts/e2e/.env by activate.sh. Never committed.
#
# The local Plow stack, as seen from the HOST. activate.sh and the
# send/transcript helpers talk to these.
PLOW_API_HOST_BASE=https://api.plow.orb.local
TWIN_HOST_BASE=https://dtu-linq.plow.orb.local

# The same API as seen from INSIDE the agent container. OrbStack resolves
# *.orb.local there and its cert is trusted, so this is the host URL verbatim.
# The plugin appends /v1 itself -- a /v1 suffix here yields /v1/v1 and 404s.
PLOW_API_BASE=https://api.plow.orb.local

# Written by activate.sh from the activation redeem.
PLOW_AGENT_TOKEN=
HERMES_CUSTOM_PLOW_API_KEY=
PLOW_HOME_CHANNEL=

# The twin's own thread id for the same conversation (chat_N, not cht_...).
# /ui/chats/{id} wants this one.
TWIN_THREAD=

# The line the chat lives on, and the member phone that plays the owner's
# handset. send.sh texts FROM the member TO the line.
LINE_PHONE=
MEMBER_PHONE=

TZ=America/Los_Angeles

# Optional, and read only when run-agent.sh is passed --latch: a real Plow
# Latch relay for the owner's Mac. Nothing mints these, so activate.sh merges
# rather than rewrites and leaves whatever is here alone.
LATCH_MCP_URL=
LATCH_MCP_TOKEN=

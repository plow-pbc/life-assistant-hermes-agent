#!/usr/bin/env bash
# Reload the gateway, if one is running, after writing something it reads at boot.
#
# One copy, called by every recipe that writes into ~/.hermes-rowan. This lived
# inline in four recipes and the copies drifted immediately — one gained a
# change-gate, the others did not; one was fatal under `set -e`, the others were
# not — and the contract test could only string-match "docker compose restart
# hermes", which cannot tell a reload that happens from one sitting behind a
# condition that is false exactly when it matters. With one copy there is a
# single place for that behaviour to be right, and it can be run directly.
#
# Non-fatal on purpose. Every caller has finished its write by the time this
# runs — activate has already spent a one-time activation — so a red exit here
# reads as "the write failed" and invites a re-run that costs far more than a
# stale process does.
set -euo pipefail
what="${1:-what was just written}"
# Separated from the empty case deliberately. Piping straight into `grep -q .`
# treats a compose that REFUSED TO RUN the same as one reporting no container:
# without HERMES_UID/GID exported, `docker compose ps` fails on compose.yml's
# own guards, prints nothing on stdout, and the pipeline reads as "no gateway is
# running" — so the reload silently never happens and the caller reports success.
if ! running="$(docker compose ps --status running --quiet hermes)"; then
    echo "could not ask docker whether the gateway is running, so ${what} may not be loaded — run this through \`just\`, which exports HERMES_UID and HERMES_GID" >&2
    exit 1
fi
# No running gateway is the normal case during first bring-up: nothing to do.
[ -n "$running" ] || exit 0
echo "restarting the gateway so it loads ${what}..."
docker compose restart hermes \
  || echo "${what} is written, but the gateway did not restart — run 'just restart'." >&2

# Rowan's life + family agent. Deployment comes from plow-pbc/agent-mgr; this
# file is the only thing that makes it this agent rather than another.

# Rowan's zone, NOT the host's. This is the one value here that differs from
# every sibling, and deliberately: they run America/Los_Angeles because that is
# where their operator is, and inheriting the fleet default would be inheriting
# the wrong person. A life assistant resolves "tomorrow morning" and every
# scheduled thing against this, so on a two-hour offset it is wrong in exactly
# the place this agent exists for.
AGENT_TZ=America/Chicago

# This agent keeps its declarative config under runtime/.
AGENT_CONFIG=runtime/config.yaml

# AGENT_HOME, AGENT_CONTAINER, AGENT_PROJECT and the image are all agent-mgr's
# defaults and already match what this agent runs: ~/.hermes-rowan,
# hermes-rowan, hermes-rowan, and the fleet-wide digest -- which is the same
# digest the old compose.yml pinned. Nothing about the running container changes.

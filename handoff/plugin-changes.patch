+    @staticmethod
+    def _parse_photos_marker(chunk):
+        """If `chunk` is an in-band [[PHOTOS:/a.png|/b.png]] marker, return the
+        list of existing absolute paths (dropping any that are missing on disk);
+        otherwise return None.
+
+        The marker is a Plow-owned, core-invisible in-band signal: core strips
+        only MEDIA: tags and [[audio_as_voice]]/[[as_document]], so this reaches
+        send() verbatim and can be sequenced between text bubbles. Paths are
+        pipe (|) separated. Nonexistent paths are skipped (never uploaded) so a
+        typo can't crash the turn; an empty list means "marker present but no
+        deliverable file" and the caller skips it.
+        """
+        stripped = chunk.strip()
+        if not (stripped.startswith(PHOTOS_SENTINEL_PREFIX) and stripped.endswith("]]")):
+            return None
+        inner = stripped[len(PHOTOS_SENTINEL_PREFIX):-2]
+        paths = []
+        for raw in inner.split("|"):
+            path = raw.strip()
+            if not path:
+                continue
+            if not os.path.isfile(path):
+                log.warning("[plow_chat] [[PHOTOS:]] path missing on disk, skipping: %s", path)
+                continue
+            paths.append(path)
+        return paths

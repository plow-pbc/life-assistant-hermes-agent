+    # Per-message attachment cap. Up to this many images ride in ONE message
+    # (rendered by iMessage as a stacked "N Photos"); a batch larger than this
+    # is chunked into groups of <= this size. This must stay <= the Plow API's
+    # MAX_ATTACHMENTS_PER_MESSAGE — the API returns 422 for any message that
+    # exceeds it. The API is being bumped 3 -> 4 (plow-pbc/plow, PR #1726);
+    # until that deploy lands, a 4-attachment post 422s and the safety fallback
+    # below degrades it to individual images (still in the right position).
+    MAX_ATTACHMENTS_PER_MESSAGE = 4
+
+    async def _post_photo_stack(self, http, chat_id, paths):
+        """Upload `paths` (absolute local files) and post them as stacked
+        "N Photos" messages, chunked to the per-message attachment cap.
+
+        Shared by send_multiple_images (real MEDIA batch) and send()'s in-band
+        [[PHOTOS:...]] marker so both use the same declare/upload/cap/fallback
+        logic. Path-based (not (url, alt)-based) so it works from send(), which
+        only has absolute paths. On any upload/post failure for a group, falls
+        back to _send_attachment per image so nothing is silently dropped and
+        the photos still land in this position. Returns True if every image
+        was delivered (stacked or fallen-back), False otherwise.
+        """
+        cap = self.MAX_ATTACHMENTS_PER_MESSAGE
+        ok = True
+        for start in range(0, len(paths), cap):
+            group_paths = paths[start:start + cap]
+
+            async def _fallback(reason):
+                # SAFETY FALLBACK: never let a stack silently drop to zero.
+                # Re-send this group one image per message via _send_attachment
+                # (plugin-owned declare/upload/post) so the photos still arrive.
+                log.warning("[plow_chat] photo-stack group of %d failed (%s); "
+                            "falling back to per-image", len(group_paths), reason)
+                group_ok = True
+                for path in group_paths:
+                    result = await self._send_attachment(chat_id, path)
+                    if result is None or not getattr(result, "success", False):
+                        group_ok = False
+                return group_ok
+
+            uids = []
+            upload_failed = False
+            for path in group_paths:
+                uid, error = await self._declare_and_upload(http, chat_id, path)
+                if error is not None:
+                    if not await _fallback(error.error):
+                        ok = False
+                    upload_failed = True
+                    break
+                uids.append(uid)
+            if upload_failed:
+                continue
 
+            log.info("[plow_chat] posting photo-stack of %d images to %s",
+                     len(uids), chat_id)
+            result = await self._post_message(
+                http, chat_id, {"body": "", "attachment_uids": uids})
+            # The post can still be rejected — most importantly a 422 when the
+            # API cap has not been bumped/deployed yet. Check the result and
+            # fall back to per-image so nothing is lost.
+            if result is None or not getattr(result, "success", False):
+                reason = getattr(result, "error", "no result") if result is not None else "no result"
+                if not await _fallback(reason):
+                    ok = False
+        return ok
+

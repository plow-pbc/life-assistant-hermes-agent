+    async def _declare_and_upload(self, http, chat_id, path, filename=None):
+        """Declare one attachment and PUT its bytes; return (uid, None) on
+        success or (None, SendResult-error) on failure.
+
+        Extracted from _send_attachment so the multi-image (photo-stack) path
+        can upload N files and reference all their uids in ONE message post.
+        The declare carries the bearer; the PUT goes to the provider's upload
+        URL with exactly the headers Plow returned and nothing else — that URL
+        is a write capability, not a Plow endpoint.
+        """
         filename = filename or os.path.basename(path)
         with open(path, "rb") as fh:
             data = fh.read()
         content_type = mimetypes.guess_type(filename)[0] or "application/octet-stream"
+        async with http.post(f"{BASE}/v1/chats/{chat_id}/attachments",
